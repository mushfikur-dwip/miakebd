APP_NAME="ShopKing - eCommerce App with Laravel Website & Admin Panel with POS | Inventory Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Debugbar follows APP_DEBUG when this is unset, so a production box that ever
# turns APP_DEBUG on gets the toolbar — and its query log and session contents —
# served to visitors. Pin it off on any public server and turn it on locally
# only when you actually want the toolbar.
DEBUGBAR_ENABLED=false

# Root that asset() builds image URLs from. Leave it unset and asset() falls
# back to whichever host the request arrived on — so a health check on the bare
# IP, or an internal http:// call, emits og:image and JSON-LD image URLs on that
# host instead of the real domain. Set it to the canonical https origin.
ASSET_URL=

# Send the session cookie only over HTTPS. Unset it defaults to false, which
# means the cookie also travels on any plain-http request the site answers.
# Set true on any public server; leave it unset locally where you use http.
SESSION_SECURE_COOKIE=true

# Minutes until an API token expires. Unset means tokens never expire, so one
# leaked token stays valid forever. 43200 is thirty days. Turning this on for
# the first time signs out every customer at once - pick a quiet moment.
SANCTUM_TOKEN_EXPIRATION=

# Generate image conversions during the upload request instead of dispatching
# them to the queue.
#
# The default is `true` — conversions become queued jobs — and QUEUE_CONNECTION
# defaults to `database`. Together that means nothing generates a thumbnail
# unless `php artisan queue:work` is running as a daemon. On this host it is
# not, so every conversion has been sitting unprocessed: the hero banner had no
# `cover` file, category and brand tiles had none, and a shared product link
# fell back to the ~1.2 MB original, which WhatsApp gives up on — which is why
# a link preview showed its title and description but no picture.
#
# false makes uploads a little slower and images actually exist.
QUEUE_CONVERSIONS_BY_DEFAULT=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT=
AWS_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FCM_SECRET_KEY=
FCM_TOPIC=

DEMO=false
TIMEZONE=Asia/Dhaka

VITE_HOST="${APP_URL}"
VITE_API_KEY=
VITE_DEMO="${DEMO}"

CURRENCY=USD
CURRENCY_SYMBOL=$
CURRENCY_POSITION=5
CURRENCY_DECIMAL_POINT=2
DATE_FORMAT=d-m-Y
TIME_FORMAT="h:i A"
DISPLAY_TYPE=fashion
NON_PURCHASE_QUANTITY=100
# --- Meta (Facebook) Pixel -------------------------------------------------
# The Pixel id, from Events Manager. Leave empty and no tracking is added at
# all. The id can also come from a snippet pasted into Admin -> Analytics; set
# it in only one of the two places and the pixel still loads exactly once.
META_PIXEL_ID=

# Conversions API: the same events sent from the server, so ad blockers and
# iOS cannot hide them. Events Manager -> Settings -> Generate access token.
# Without a token the browser pixel simply works alone.
META_CAPI_TOKEN=

# Set while checking Events Manager -> Test events, then remove it again.
META_CAPI_TEST_CODE=

# Which product field the Facebook catalogue feed is keyed on: id or sku.
# Dynamic product ads only match when this agrees with the feed.
META_CONTENT_ID=id

# --- TikTok Pixel -----------------------------------------------------------
# The pixel code from TikTok Events Manager (20 letters and digits). Leave
# empty and nothing is added. As with Meta, it can instead come from a snippet
# pasted into Admin -> Analytics; either way it loads exactly once.
TIKTOK_PIXEL_ID=
